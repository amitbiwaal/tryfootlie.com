# ---------------------------------------------------------------
# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# REQUIRED — password for /admin. Use a long, unique one.
ADMIN_PASSWORD=

# Recommended — random string used to sign the admin session cookie.
# If omitted, a secret is derived from ADMIN_PASSWORD.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Canonical site URL (no trailing slash). Defaults to https://tryfootlie.com
NEXT_PUBLIC_SITE_URL=https://tryfootlie.com

# Optional — override the affiliate link used by every "Start selling" button.
NEXT_PUBLIC_AFFILIATE_URL=

# Optional — public contact email shown on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional — time zone used for the dates shown on posts (IANA name). Defaults to UTC.
# Example for India: Asia/Kolkata
NEXT_PUBLIC_TIME_ZONE=

# ---------------------------------------------------------------
# CMS storage (posts + contact messages) — Upstash Redis.
# Vercel: Storage → Create Database → Upstash for Redis → connect to project.
# These variables are added automatically (either naming pair works).
# ---------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------
# Image uploads in the editor — Vercel Blob (public store).
# Vercel: Storage → Create → Blob → connect to project.
# Without it you can still add images by pasting an image URL.
# ---------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
